{
  "id": "lazer.youtube",
  "name": "YouTube Music",
  "version": "0.1.5",
  "description": "专为 Lazer 打造的 YouTube & YouTube Music Lua Gateway 插件，支持精准毫秒级逐行滚动歌词与高清音频流。",
  "author": "VincentZyu",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "youtube",
  "capabilities": [
    "search",
    "lyrics",
    "homeFeed",
    "charts",
    "radio",
    "recommendations",
    "favorites"
  ],
  "auth": [
    "cookie"
  ],
  "permissions": {
    "network": [
      "*.youtube.com",
      "music.youtube.com",
      "www.youtube.com",
      "youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.googleusercontent.com",
      "*.google.com",
      "google.com"
    ],
    "storage": true
  }
}
