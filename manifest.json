{
  "id": "lazer.youtube",
  "name": "YouTube Music",
  "version": "0.2.8",
  "description": "专为 Lazer 打造的 YouTube & YouTube Music Lua Gateway 插件，支持手机扫码授权登录、全域曲库与视频链接检索、InnerTube 纯音频直链调度、毫秒级时序歌词及喜欢歌单分页。",
  "author": "VincentZyu",
  "entry": "main.lua",
  "apiVersion": 1,
  "provider": "youtube",
  "capabilities": [
    "search",
    "lyrics",
    "playlists",
    "browseAlbums",
    "homeFeed",
    "charts",
    "radio",
    "recommendations",
    "favorites"
  ],
  "auth": [
    "qr",
    "cookie"
  ],
  "permissions": {
    "network": [
      "*.youtube.com",
      "music.youtube.com",
      "www.youtube.com",
      "youtube.com",
      "*.googlevideo.com",
      "*.ytimg.com",
      "*.googleusercontent.com",
      "*.google.com",
      "google.com",
      "*.googleapis.com",
      "oauth2.googleapis.com",
      "cdn.jsdelivr.net",
      "raw.githubusercontent.com"
    ],
    "storage": true
  }
}
